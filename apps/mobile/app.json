{
  "expo": {
    "name": "বাকি খাতা",
    "slug": "baki-khata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asmshaon.bakikhata"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.asmshaon.bakikhata"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "গ্রাহকের ছবি বাছাই করতে গ্যালারি দেখার অনুমতি দরকার।",
          "cameraPermission": "গ্রাহকের ছবি তুলতে ক্যামেরার অনুমতি দরকার।",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Kalpurush.ttf"
          ]
        }
      ]
    ],
    "scheme": "bakikhata"
  }
}
