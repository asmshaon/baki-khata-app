# Used by docker-compose.yml. Copy to .env (gitignored) and fill in.

# MySQL root password for the db container. Letters and digits only (it goes into a URL).
MYSQL_ROOT_PASSWORD=change-me

# At least 32 characters: openssl rand -hex 32
JWT_SECRET=

# This computer's LAN IP, so a phone on the same Wi-Fi can reach Expo and the API.
# Linux: hostname -I   macOS: ipconfig getifaddr en0   Windows: ipconfig
HOST_IP=192.168.1.10
